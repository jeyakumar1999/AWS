    Write-Host "Main OU '$ParentOUName' not found. Creating it now..." -ForegroundColor Yellow
    New-ADOrganizationalUnit -Name $ParentOUName `
                             -Path $DomainDN `
                             -ProtectedFromAccidentalDeletion $false `
                             -Description "Main Parent OU for Resources"
    Write-Host "Successfully created Main OU: $MainOUDN" -ForegroundColor Green
}

# 2. Define the list of Sub-OUs you want to create inside it
