foreach ($SubOU in $SubOUs) {
    # Construct the full target Distinguished Name for the validation check
    $TargetDN = "OU=$SubOU,$MainOUDN"
    
    # FIX: Use -Filter instead of -Identity. -Filter returns $null safely if the object isn't found.
    if (-not (Get-ADOrganizationalUnit -Filter "DistinguishedName -eq '$TargetDN'")) {
        New-ADOrganizationalUnit -Name $SubOU `
                                 -Path $MainOUDN `
                                 -ProtectedFromAccidentalDeletion $false `
                                 -Description "Sub-OU for $SubOU accounts"
        
